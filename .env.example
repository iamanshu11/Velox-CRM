# ─────────────────────────────────────────────────────────────────────────────
#  Velox-CRM  —  Root environment variables for docker-compose
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the values below (especially JWT_SECRET)
#  3. Run:              docker compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL password used by both the postgres container and the backend
DB_PASSWORD=postgres

# REQUIRED — change this to a long random string before going to production
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_secret_string

# Backend API URL baked into the React bundle at build time (Vite — not runtime).
# Used by axios, public form embeds (/embed/:id), and CSV export.
# For local Docker: keep http://localhost:5001/api
# For testing/production CI: set to your public API URL before `docker compose build frontend`
#   e.g. VITE_API_URL=https://api-test.yourapp.com/api docker compose build frontend
VITE_API_URL=http://localhost:5001/api

# Velox eSIM platform (separate service) — CRM backend only
VELOX_API_URL=http://localhost:5000
VELOX_API_KEY=velox-crm-secret-change-this-to-something-random

# VeloxVerse admin proxy (separate service, typically port 5005)
# In VeloxVerse's .env set CRM_BRIDGE_ENABLED=true and CRM_JWT_SECRET to the
# same value as JWT_SECRET above, then restart the VeloxVerse backend.
VELOXVERSE_API_URL=http://host.docker.internal:5005/api/v1
